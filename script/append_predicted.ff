bearing = 146

pa = 0x3071
pi = 0x3074
pu = 0x3077
pe = 0x307a
po = 0x307d
semi_voiced = 0x309c

file = Array(65536)
k = 0
while (k < SizeOf(file))
  file[k++] = 0
endloop

file[pa] = "Pa"
file[pi] = "Pi"
file[pu] = "Pu"
file[pe] = "Pe"
file[po] = "Po"
file[semi_voiced] = "゜"

map = Array(65536)
k = 0
while (k < SizeOf(map))
  map[k++] = 0
endloop

map[pa] = [0x30d1]
map[pi] = [0x30d4]
map[pu] = [0x30d7]
map[pe] = [0x30da]
map[po] = [0x30dd]
map[semi_voiced] = [0x309a, 0xff9f]

k = 0
while (k < SizeOf(map))
  name = file[k]
  if (TypeOf(name) == "String")
    code = k
    Select(code)
    flag = 0
    flag += 8 // Correct direction (PostScript)
    flag += 16 // Remove anything currently present (works for SVG & EPS)
    flag += 64 // Don’t scale images and SVGs to ascender height
    Import("../glyph/" + name + ".svg", 0, flag)
    SetLBearing(bearing)
    SetRBearing(bearing)
    AutoHint()

    target = map[k]
    if (TypeOf(target) == "Array")
        Select(code)
        CopyReference()
        j = 0
        while (j < SizeOf(target))
            Select(target[j])
            Clear()
            Paste()
            SetLBearing(bearing)
            SetRBearing(bearing)
            AutoHint()
            j++
        endloop
    endif
  endif
  k++
endloop
