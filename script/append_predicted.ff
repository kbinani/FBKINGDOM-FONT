bearing = 146

pa = 0x3071
pi = 0x3074
pu = 0x3077
pe = 0x307a
po = 0x307d
semi_voiced = 0x309c

file = Array(65536)
k = 0
while (k < SizeOf(file))
  file[k++] = 0
endloop

file[pa] = "Pa"
file[pi] = "Pi"
file[pu] = "Pu"
file[pe] = "Pe"
file[po] = "Po"
file[semi_voiced] = "゜"

map = Array(65536)
k = 0
while (k < SizeOf(map))
  map[k++] = 0
endloop

map[pa] = [0x30d1]
map[pi] = [0x30d4]
map[pu] = [0x30d7]
map[pe] = [0x30da]
map[po] = [0x30dd]
map[semi_voiced] = [0x309a, 0xff9f]

k = 0
while (k < SizeOf(map))
  name = file[k]
  if (TypeOf(name) == "String")
    code = k
    Select(code)
    Clear()
    Import("../glyph/" + name + ".svg", 0, 64 + 8)
    SetLBearing(bearing)
    SetRBearing(bearing)
    AutoHint()

    target = map[k]
    if (TypeOf(target) == "Array")
        Select(code)
        Copy()
        j = 0
        while (j < SizeOf(target))
            Select(target[j])
            Paste()
            SetLBearing(bearing)
            SetRBearing(bearing)
            AutoHint()
            j++
        endloop
    endif
  endif
  k++
endloop

# enclosed
code = 0x32fb
while (code <= 0x32fe)
    Select(code)
    SetWidth(1000)
    CenterInWidth()
    Scale(65)
    Import("../glyph/enclosure.svg")
    SetWidth(1000)
    AutoHint()
    code++
endloop
